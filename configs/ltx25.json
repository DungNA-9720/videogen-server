    "max_reference_images": 0,
    "resolutions": [
      "1280x704",
      "1920x1080"
    ]
  },
  "pricing": {
    "usd_per_second": 0.004
  },
  "storage": {
    "hf_home": "/srv/models/hf",
    "min_free_gb": 40,
    "scratch_dir": "/srv/videogen/scratch",
    "s3_bucket": "vidgen-assets",
    "s3_prefix": "selfhost/ltx25/"
  },
  "service": {
    "base_url": "http://gpu-01:8800",
    "callback_url": "http://api.internal/webhooks/providers/selfhost",
    "callback_hmac_secret_env": "SELFHOST_WEBHOOK_SECRET"
  }
