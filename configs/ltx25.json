{
  "schema_version": 1,
  "provider_name": "selfhost-ltx25",
  "backend": "diffusers",
  "model": {
    "model_id": "Lightricks/LTX-2.5-Diffusers",
    "revision": "main",
    "pipeline_class": "LTX2ConditionPipeline",
    "torch_dtype": "bfloat16",
    "variant": null,
    "allow_patterns": null,
    "ignore_patterns": [
      "transformer_full/*",
      "ltx-2.5-22b-distilled-lora-450-bf16.safetensors"
